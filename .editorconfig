# EditorConfig aide à maintenir un style de codage cohérent entre différents éditeurs et IDEs
# https://editorconfig.org

root = true

# Tous les fichiers
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Python
[*.py]
indent_size = 4
max_line_length = 88

# Java
[*.java]
indent_size = 4

# C/C++
[*.{c,cpp,h,hpp}]
indent_size = 4

# Makefiles
[Makefile]
indent_style = tab

# YAML
[*.{yml,yaml}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 4
